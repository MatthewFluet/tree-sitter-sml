{
  "$schema": "https://tree-sitter.github.io/tree-sitter/assets/schemas/config.schema.json",
  "grammars": [
    {
      "name": "sml",
      "camelcase": "SML",
      "title": "SML (Standard ML)",
      "scope": "source.sml",
      "file-types": [
        "sml",
        "sig",
        "fun",
        "ML"
      ],
      "injection-regex": "^sml$",
      "class-name": "TreeSitterSML",
      "highlights": "queries/highlights.scm"
    }
  ],
  "metadata": {
    "version": "0.25.0",
    "license": "MIT",
    "description": "Standard ML (SML) grammar for tree-sitter",
    "authors": [
      {
        "name": "Matthew Fluet",
        "email": "Matthew.Fluet@gmail.com",
        "url": "https://github.com/MatthewFluet"
      }
    ],
    "links": {
      "repository": "https://github.com/MatthewFluet/tree-sitter-sml"
    }
  },
  "bindings": {
    "c": true,
    "go": true,
    "node": true,
    "python": true,
    "rust": true,
    "swift": true,
    "zig": false
  }
}
